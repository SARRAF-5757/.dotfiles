#-------------- UI --------------#
macos-icon = custom
macos-titlebar-style = tabs
window-height = 32
window-width = 100
window-padding-x = 10,10
window-padding-y = 5,10
window-padding-balance = true
cursor-style = bar
cursor-color = #B4CC51
shell-integration-features = no-cursor
cursor-style-blink = false
cursor-text = red

#-------------- THEME --------------#
# To see available themes- 'ghostty +list-themes'
theme = #MyTheme
font-size = 16
font-family = MonaspiceAr Nerd Font Mono
font-style = Medium

background = black
background-opacity = 0.57
background-blur-radius = 60

background-image = /Users/sarraf/.dotfiles/.config/ghostty/themes/swirl.png
background-image-opacity = 0.02
background-image-position = center
background-image-fit = contain


#-------------- BEHAVIOR --------------#
working-directory = /Users/sarraf/
window-inherit-working-directory = false
window-save-state = always
window-new-tab-position = end
cursor-click-to-move = true

#-------------- KEYBINDS --------------#
keybind = super+a=select_all
