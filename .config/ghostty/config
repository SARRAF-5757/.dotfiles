#-------------- UI --------------#
macos-icon = custom
macos-titlebar-style = tabs
window-height = 37
window-width = 122
window-padding-x = 10,10
window-padding-y = 5,10
window-padding-balance = true
cursor-style = bar
adjust-cursor-thickness = 3
cursor-color = #ffa217
shell-integration-features = no-cursor
cursor-style-blink = false
cursor-text = red

#-------------- THEME --------------#
# To see available themes- 'ghostty +list-themes'
#theme = *MyTheme
theme = TokyoNight
font-size = 16
font-family = MonaspiceAr Nerd Font Mono
font-style = Medium

background = black
background-opacity = 0.57
background-blur-radius = 60

#background-image = /Users/sarraf/.dotfiles/.config/ghostty/themes/swirl.png
background-image-opacity = 0.02
background-image-position = center
background-image-fit = contain

#---------------- SHADERS --------------#
#---Cursors---#
#custom-shader = shaders/cursor_blaze_no_trail.glsl
custom-shader = shaders/cursor_blaze_tapered.glsl
