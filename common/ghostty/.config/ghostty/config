#-------------- UI --------------#
macos-icon = custom
macos-titlebar-style = tabs
# window-height = 37
# window-width = 122
window-padding-x = 10,10
window-padding-y = 5,7
window-padding-balance = true
cursor-style = bar
adjust-cursor-thickness = 2
cursor-color = #178bff
shell-integration-features = no-cursor
cursor-style-blink = false
cursor-text = red
scrollbar = never

#-------------- THEME --------------#
# To see available themes- 'ghostty +list-themes'
#theme = *MyTheme
theme = Catppuccin Mocha
font-size = 15
font-family = MonaspiceAr Nerd Font Mono
font-style = Medium

background = black
background-opacity = 0.65
background-blur-radius = 60

#background-image = ~/.config/ghostty/themes/swirl.png
background-image-opacity = 0.02
background-image-position = center
background-image-fit = contain

