#!/bin/bash
# -----------------------------------------------------------------------------
# Fedora Asahi Linux System & Tools Updater
# -----------------------------------------------------------------------------

set -e

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
NC='\033[0m'

echo -e "${YELLOW}󰣛 Updating Fedora DNF packages...${NC}"
sudo dnf upgrade --refresh -y
echo ""

if command -v flatpak &>/dev/null; then
    echo -e "${BLUE}󰏓 Updating Flatpaks...${NC}"
    flatpak update -y
    echo ""
fi

if command -v npm &>/dev/null; then
    echo -e "${GREEN}󰎙 Updating npm global packages...${NC}"
    npm install -g npm@latest 2>/dev/null || true
    npm update -g 2>/dev/null || true
    echo ""
fi

if command -v pipx &>/dev/null; then
    echo -e "${CYAN}󰌠 Updating pipx packages...${NC}"
    pipx upgrade-all || true
    echo ""
fi

if [[ -d "$HOME/.oh-my-zsh" ]]; then
    echo -e "${PURPLE}󱆃 Updating Oh My Zsh...${NC}"
    "$HOME/.oh-my-zsh/tools/upgrade.sh" || true
    echo ""
fi

if command -v oh-my-posh &>/dev/null; then
    echo -e "${PURPLE}󰘧 Updating Oh My Posh...${NC}"
    oh-my-posh upgrade || true
    echo ""
fi

if command -v nvim &>/dev/null; then
    echo -e "${CYAN}󰕷 Updating Neovim Plugins (Lazy.nvim)...${NC}"
    nvim "+Lazy! sync" +qa || true
    echo ""
fi

if command -v figlet &>/dev/null && command -v lolcat &>/dev/null; then
    echo "Update Finished" | figlet | lolcat
else
    echo -e "${GREEN}✓ Update Finished Successfully!${NC}"
fi
