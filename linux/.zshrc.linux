# -----------------------------------------------------------------------------
# Linux (Fedora Asahi / KDE Plasma) Specific Zsh Configuration (~/.zshrc.linux)
# -----------------------------------------------------------------------------

# XDG Base Directory Specification
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Wayland & Desktop Environment Variables (Optimized for Fedora Asahi & KDE Plasma)
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export GDK_BACKEND="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1

# Flatpak and Local Bin Paths
export PATH="$HOME/.local/bin:/var/lib/flatpak/exports/bin:$HOME/.local/share/flatpak/exports/bin:$PATH"

# Package Management Aliases (Fedora DNF & Flatpak)
alias update="sudo dnf upgrade --refresh -y && flatpak update -y"
alias dnf-in="sudo dnf install"
alias dnf-rm="sudo dnf remove"
alias dnf-se="dnf search"
alias dnf-up="sudo dnf upgrade --refresh"
alias fp="flatpak"
alias fpi="flatpak install"
alias fpu="flatpak update"
alias fpr="flatpak run"

# Cross-Platform Muscle Memory: Map pbcopy / pbpaste to Wayland clipboard
if command -v wl-copy &>/dev/null; then
    alias pbcopy="wl-copy"
    alias pbpaste="wl-paste"
elif command -v xclip &>/dev/null; then
    alias pbcopy="xclip -selection clipboard"
    alias pbpaste="xclip -selection clipboard -o"
fi

# Asahi Linux / Apple Silicon Specific Utilities
if [[ -d "/sys/class/power_supply/macsmc-battery" ]] || [[ -d "/sys/class/power_supply/BAT0" ]]; then
    alias battery="upower -i \$(upower -e | grep 'BAT') 2>/dev/null || cat /sys/class/power_supply/macsmc-battery/status 2>/dev/null || cat /sys/class/power_supply/BAT0/status"
    alias battery-capacity="cat /sys/class/power_supply/macsmc-battery/capacity 2>/dev/null || cat /sys/class/power_supply/BAT0/capacity"
fi

# KDE Plasma / System Helpers
alias plasma-restart="kquitapp6 plasmashell && kstart plasmashell"
alias krunner="krunner"
